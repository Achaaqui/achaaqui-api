# Use a random value with at least 32 characters in production.
JWT_SECRET_KEY=development-only-change-this-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Development PostgreSQL. The hostname `postgres` is the Compose service name.
POSTGRES_DB=achaaqui
POSTGRES_USER=achaaqui
POSTGRES_PASSWORD=achaaqui_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://achaaqui:achaaqui_dev_password@postgres:5432/achaaqui

# Keys used by the LangChain search flow.
OPENAI_API_KEY=
TAVILY_API_KEY=
